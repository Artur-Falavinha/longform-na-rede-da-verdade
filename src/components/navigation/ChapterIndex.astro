---
import { chapters } from "../../data/chapters";
---

<header class="site-header" data-chapter-index>
  <a class="wordmark" href="#contexto">
    Na rede da verdade
  </a>
  <details class="chapter-menu">
    <summary>
      <span>Capítulos</span>
      <span class="current-chapter" data-current-chapter>
        Abertura
      </span>
      <span aria-hidden="true">+</span>
    </summary>
    <nav aria-label="Capítulos da reportagem">
      <ol>
        {chapters.map((chapter, i) => (
          <li>
            <a href={`#${chapter.id}`}>
              <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              {chapter.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
</header>
<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    min-height: var(--header-height);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
    background: var(--bg);
    border-bottom: 1px solid var(--surface);
    gap: 1rem;
  }
  .wordmark {
    font: 400 1.05rem/1.3 var(--serif);
    text-decoration: none;
  }
  .chapter-menu {
    position: relative;
    flex-shrink: 0;
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-height);
    font: 400 0.8125rem/1.4 var(--sans);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .current-chapter {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .chapter-menu[open] summary > span:last-child {
    transform: rotate(45deg);
  }
  nav {
    position: absolute;
    right: 0;
    top: 100%;
    width: 21rem;
    max-width: calc(100vw - 2 * var(--gutter));
    max-height: calc(90svh - var(--header-height) - var(--compact-space));
    overflow: auto;
    background: var(--surface);
    border: 1px solid var(--muted);
    padding: 1rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin: 0;
  }
  nav a {
    display: flex;
    gap: 1rem;
    padding: 0.65rem;
    text-decoration: none;
    font-size: 0.875rem;
    min-height: 44px;
  }
  nav a span {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  nav a[aria-current="location"] {
    color: var(--accent);
  }
  @media (max-width: 899px) {
    .current-chapter {
      display: none;
    }
    summary {
      gap: 0.75rem;
    }
    .wordmark {
      font-size: 0.9375rem;
    }
  }
</style>
