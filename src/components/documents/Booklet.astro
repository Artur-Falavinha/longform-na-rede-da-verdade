---
import { Download } from "@lucide/astro";
import { booklet } from "../../data/documents";
---

<div class="booklet" data-booklet>
  <a
    class="booklet-preview"
    data-booklet-action="open"
    href={booklet.src}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Abrir cartilha em nova guia"
  >
    <img
      src={booklet.cover}
      alt="Capa da cartilha sobre adultização"
      width="600"
      height="800"
      loading="lazy"
    />
    <span class="booklet-caption">{booklet.title}</span>
  </a>
  <a
    class="booklet-download"
    data-booklet-action="download"
    href={booklet.src}
    download={booklet.downloadName}
    aria-label="Baixar cartilha em PDF"
    title="Baixar cartilha em PDF"
  >
    <Download size={22} aria-hidden="true" />
  </a>
  <p data-document-error role="status" class="pending" hidden>
    Não foi possível verificar o documento. Confira sua conexão e tente
    novamente pelos links acima.
  </p>
</div>
<style>
  .booklet {
    position: relative;
  }
  .booklet-preview {
    display: block;
    border: 1px solid var(--muted);
    text-decoration: none;
    background: var(--surface);
  }
  .booklet-preview:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .booklet-preview img {
    width: 100%;
    height: auto;
  }
  .booklet-caption {
    display: block;
    padding: 0.8rem;
    font: 400 0.8125rem/1.4 var(--sans);
  }
  .booklet-download {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--bg);
    border: 1px solid var(--muted);
  }
  .booklet-download:hover {
    border-color: var(--accent);
  }
  [data-document-error] {
    margin-top: 1rem;
  }
</style>
