---
import { ArrowUpRight, Download } from "@lucide/astro";
import { booklet } from "../../data/documents";
---

<div class="booklet" data-booklet>
  <div class="booklet-cover">
    <a
      class="booklet-preview"
      data-booklet-action="open"
      href={booklet.src}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Abrir cartilha em nova guia"
    >
      <span class="booklet-format" aria-hidden="true">
        PDF
      </span>
      <img
        src={booklet.cover}
        alt="Capa da cartilha sobre adultização"
        width="881"
        height="492"
        loading="lazy"
      />
      <span class="booklet-action" aria-hidden="true">
        Abrir cartilha <ArrowUpRight size={16} />
      </span>
    </a>
    <a
      class="booklet-download"
      data-booklet-action="download"
      href={booklet.src}
      download={booklet.downloadName}
      aria-label="Baixar cartilha em PDF"
      title="Baixar cartilha em PDF"
    >
      <Download size={22} aria-hidden="true" />
    </a>
  </div>
  <p data-document-error role="status" class="pending" hidden>
    Não foi possível verificar o documento. Confira sua conexão e tente
    novamente pelos links acima.
  </p>
</div>
<style>
  .booklet {
    position: relative;
  }
  .booklet-cover {
    position: relative;
    border-radius: 0.125rem;
    box-shadow:
      2px 2px 0 color-mix(in srgb, var(--muted) 40%, var(--surface)),
      4px 4px 0 var(--surface),
      0 0.75rem 1.5rem color-mix(in srgb, var(--bg) 55%, transparent);
  }
  .booklet-preview {
    display: grid;
    grid-template-rows: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem 0.875rem;
    aspect-ratio: 4 / 5;
    border: 1px solid color-mix(in srgb, var(--muted) 35%, var(--surface));
    border-radius: inherit;
    text-decoration: none;
    background: var(--surface);
  }
  .booklet-preview img {
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--muted) 20%, var(--surface));
  }
  .booklet-format {
    color: var(--muted);
    font: 600 0.6875rem/1 var(--sans);
    letter-spacing: 0.1em;
  }
  .booklet-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.375rem;
    border-top: 1px solid color-mix(in srgb, var(--muted) 20%, var(--surface));
    padding-top: 0.75rem;
    font-size: 0.875rem;
  }
  .booklet-download {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    touch-action: manipulation;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }
  .booklet-download:hover {
    background: var(--red);
    border-color: var(--red);
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    .booklet-download {
      transition: none;
    }
  }
  .booklet-preview:focus-visible,
  .booklet-download:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  [data-document-error] {
    margin-top: 1rem;
  }
</style>
