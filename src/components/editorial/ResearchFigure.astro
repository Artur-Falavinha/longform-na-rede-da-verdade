---
interface Props {
  caption: string;
  rows: readonly { label: string; value: string }[];
  note?: string;
}
const { caption, rows, note } = Astro.props;
---

<figure class="research-figure">
  <figcaption class="eyebrow">{caption}</figcaption>
  <dl>
    {rows.map((row) => (
      <div>
        <dt>{row.label}</dt>
        <dd>{row.value}</dd>
      </div>
    ))}
  </dl>
  <p class="source">
    Fonte:{" "}
    <a
      href="https://narededaverdade.base44.app/"
      target="_blank"
      rel="noopener noreferrer"
    >
      conteúdo inicial das autoras
    </a>
    . {note}
  </p>
</figure>
<style>
  .research-figure {
    margin-block: 3rem;
  }
  dl {
    margin: 1.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 3rem;
  }
  dl > div {
    border-top: 1px solid var(--surface);
    padding-top: 1rem;
  }
  dt {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  dd {
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    margin: 0.35rem 0 0;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 599px) {
    dl {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
