---
import {
  Play,
  Pause,
  X,
  RotateCcw,
  RotateCw,
  Volume2,
  VolumeX,
  ChevronDown,
} from "@lucide/astro";
import type { MediaAsset } from "../../data/types";
import { workerUrl } from "../../delivery/worker-url";
interface Props {
  asset: MediaAsset;
  episode: number;
}
const { asset, episode } = Astro.props;
const src = workerUrl(asset.src);
const waveHeights =
  episode === 1 ? [4, 14, 26, 32, 10, 4] : [8, 20, 8, 32, 16, 4];
const anchor =
  asset.id === "checking-future"
    ? "podcast-checagem-e-futuro"
    : "podcast-jornalista-e-influenciador";
---

<article
  class="podcast"
  id={anchor}
  data-podcast={asset.id}
  aria-labelledby={`${anchor}-title`}
>
  <div class="player-origin" data-player-origin>
    <div class="player-surface" data-player-surface>
      <button
        type="button"
        class="close-player"
        data-podcast-close
        aria-label={`Fechar reprodução de ${asset.title}`}
      >
        <X size={22} aria-hidden="true" />
      </button>
      <header class="episode-header">
        <div class="episode-art" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor">
            <circle cx="32" cy="32" r="27" opacity=".25" />
            <circle cx="32" cy="32" r="21" opacity=".25" />
            {waveHeights.map((height, index) => (
              <line
                data-wave-bar
                x1={17 + 6 * index}
                x2={17 + 6 * index}
                y1={32 - height / 2}
                y2={32 + height / 2}
                stroke-width="1.5"
                stroke-linecap="round"
              />
            ))}
          </svg>
        </div>
        <div>
          <span class="eyebrow">
            Podcast · Episódio {String(episode).padStart(2, "0")}
          </span>
          <h3 id={`${anchor}-title`}>{asset.title}</h3>
        </div>
      </header>
      <audio
        controls
        preload="none"
        src={src}
        data-media-id={asset.id}
        data-purpose="editorial"
        aria-label={
          asset.status === "placeholder"
            ? `${asset.title} — áudio de teste`
            : asset.title
        }
      ></audio>
      <div class="player-controls" hidden>
        <button
          type="button"
          class="speed-control"
          data-podcast-speed
          aria-label="Velocidade de reprodução: 1 vez"
        >
          1×
        </button>
        <div class="transport-controls">
          <button
            type="button"
            class="transport-button"
            data-podcast-skip="-15"
            aria-label="Voltar 15 segundos"
          >
            <RotateCcw size={25} aria-hidden="true" />
            <span aria-hidden="true">15</span>
          </button>
          <button
            type="button"
            data-podcast-play
            class="play-control"
            aria-label={`Reproduzir ${asset.title}`}
          >
            <span data-play-icon aria-hidden="true">
              <Play size={24} fill="currentColor" />
            </span>
            <span data-pause-icon aria-hidden="true" hidden>
              <Pause size={24} fill="currentColor" />
            </span>
          </button>
          <button
            type="button"
            class="transport-button"
            data-podcast-skip="15"
            aria-label="Avançar 15 segundos"
          >
            <RotateCw size={25} aria-hidden="true" />
            <span aria-hidden="true">15</span>
          </button>
        </div>
        <div class="volume-control">
          <button
            type="button"
            data-podcast-mute
            class="mute-control"
            aria-label="Silenciar áudio"
            aria-pressed="false"
          >
            <span data-volume-icon>
              <Volume2 size={20} aria-hidden="true" />
            </span>
            <span data-muted-icon hidden>
              <VolumeX size={20} aria-hidden="true" />
            </span>
          </button>
          <label class="sr-only" for={`volume-${asset.id}`}>
            Volume
          </label>
          <input
            id={`volume-${asset.id}`}
            data-podcast-volume
            type="range"
            min="0"
            max="1"
            value="1"
            step="0.05"
          />
        </div>
        <div class="progress-control">
          <label class="sr-only" for={`progress-${asset.id}`}>
            Posição do áudio {asset.title}
          </label>
          <span data-current-time>0:00</span>
          <input
            id={`progress-${asset.id}`}
            data-podcast-progress
            type="range"
            min="0"
            max="100"
            value="0"
            step="0.1"
            disabled
          />
          <span data-duration>--:--</span>
        </div>
      </div>
      <p class="podcast-error small" role="status" hidden>
        Não foi possível reproduzir. Use Reproduzir para tentar novamente ou{" "}
        <a href={src}>abra o arquivo</a>.
      </p>
    </div>
  </div>
  <details class="transcript">
    <summary>
      <ChevronDown size={18} aria-hidden="true" /> Transcrição{" "}
    </summary>
    <div class="transcript-content">
      <div class="transcript-copy">
        {
          asset.transcript?.length ? (
            asset.transcript.map(({ text }) => <p>{text}</p>)
          ) : (
            <p>Transcrição pendente de envio</p>
          )
        }
      </div>
    </div>
  </details>
</article>
<style>
  .podcast {
    margin-block: clamp(2rem, 4vw, 3rem);
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }
  .player-surface {
    --player-border: color-mix(in srgb, var(--muted) 20%, var(--surface));
    --player-track: color-mix(in srgb, var(--muted) 42%, var(--surface));
    --play-size: 3.5rem;
    container-type: inline-size;
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: clamp(0.875rem, 2.5vw, 1.5rem);
    border: 1px solid var(--player-border);
    border-radius: 0.75rem;
    background: var(--surface);
  }
  .episode-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.875rem, 2vw, 1.25rem);
  }
  .episode-art {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 8vw, 5.25rem);
    aspect-ratio: 1;
    border-radius: 0.375rem;
    background: var(--red);
    color: var(--text);
  }
  [data-podcast="journalist-influencer"] .episode-art {
    background: var(--bg);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--player-border);
  }
  .episode-art svg {
    display: block;
    width: 80%;
  }
  [data-wave-bar] {
    transform-box: view-box;
    transform-origin: center;
  }
  .episode-header .eyebrow {
    font-size: 0.6875rem;
    margin-bottom: 0.25rem;
  }
  .episode-header h3 {
    font-size: clamp(1.25rem, 4vw, 2.125rem);
    text-wrap: initial;
  }
  audio {
    width: 100%;
    height: 3rem;
  }
  .player-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .transport-controls,
  .volume-control {
    display: flex;
    align-items: center;
  }
  .transport-controls {
    gap: clamp(0.125rem, 1.5vw, 0.75rem);
  }
  .volume-control {
    justify-self: end;
    width: min(100%, 8rem);
  }
  .transport-button,
  .speed-control,
  .mute-control,
  .close-player {
    display: grid;
    place-items: center;
    padding: 0;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    background: transparent;
    color: var(--muted);
    transition: color 180ms ease;
  }
  .transport-button {
    position: relative;
  }
  .transport-button span {
    position: absolute;
    top: 52%;
    left: 50%;
    transform: translate(-50%, -50%);
    font: 600 0.5625rem/1 var(--sans);
  }
  .speed-control {
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .play-control {
    display: grid;
    place-items: center;
    padding: 0;
    width: var(--play-size);
    height: var(--play-size);
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    transition: transform 180ms ease;
  }
  .play-control > span:not([hidden]),
  .mute-control > span:not([hidden]) {
    display: grid;
    place-items: center;
  }
  .play-control [data-play-icon] {
    transform: translateX(1px);
  }
  .progress-control {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1;
  }
  [data-duration] {
    text-align: right;
  }
  input[type="range"] {
    --progress: 0%;
    appearance: none;
    width: 100%;
    min-width: 0;
    height: 2.75rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  input[type="range"]:disabled {
    cursor: default;
  }
  input[type="range"]::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(
      to right,
      var(--accent) var(--progress),
      var(--player-track) var(--progress)
    );
  }
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text);
    margin-top: -4px;
  }
  input[type="range"]::-moz-range-track {
    height: 4px;
    border-radius: 4px;
    background: var(--player-track);
  }
  input[type="range"]::-moz-range-progress {
    height: 4px;
    background: var(--accent);
  }
  input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--text);
  }
  .close-player {
    display: none;
  }
  .player-surface.is-compact {
    --play-size: 2.75rem;
    --compact-bottom: max(0.75rem, env(safe-area-inset-bottom));
    position: fixed;
    bottom: var(--compact-bottom);
    right: var(--gutter);
    z-index: 30;
    width: min(24rem, calc(100% - 2 * var(--gutter)));
    max-block-size: calc(
      100% - var(--header-height) - var(--compact-bottom) - 0.75rem
    );
    overflow: auto;
    overscroll-behavior: contain;
    gap: 0.5rem;
    padding: 0.875rem 1rem 0.5rem;
    box-shadow: 0 0.5rem 2rem var(--bg);
  }
  .is-compact .close-player {
    display: grid;
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
  }
  .is-compact .episode-header {
    gap: 0.75rem;
    padding-right: 2.375rem;
  }
  .is-compact .episode-art {
    width: 2.75rem;
  }
  .is-compact .episode-header h3 {
    font-size: 1.125rem;
    line-height: 1.2;
  }
  .is-compact .episode-header .eyebrow {
    font-size: 0.625rem;
    margin-bottom: 0.125rem;
  }
  .is-compact .transport-controls {
    gap: 0.125rem;
  }
  @media (max-height: 500px) {
    .player-surface.is-compact {
      gap: 0.375rem;
      padding-block-start: 0.5rem;
    }
    .is-compact .episode-header {
      gap: 0.5rem;
    }
    .is-compact .episode-art {
      width: 2rem;
    }
    .is-compact .episode-header .eyebrow {
      display: none;
    }
  }
  .transcript {
    font-size: 1rem;
  }
  .transcript summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding-block: 1rem;
    font-size: 0.875rem;
    min-height: 44px;
  }
  .transcript-content {
    overflow: hidden;
  }
  .transcript summary::-webkit-details-marker {
    display: none;
  }
  .transcript-copy {
    display: grid;
    gap: 1rem;
    padding-block: 1rem 2rem;
  }
  .transcript-copy p {
    margin: 0;
  }
  @media (min-width: 900px) {
    .transcript-copy p {
      text-align: justify;
      hyphens: auto;
    }
  }
  .podcast-error {
    color: var(--accent);
  }
  @container (max-width: 17rem) {
    .player-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .transport-controls {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
    }
  }
  @media (hover: hover) {
    .play-control:hover {
      transform: scale(1.06);
    }
    .transport-button:hover,
    .speed-control:hover,
    .mute-control:hover,
    .close-player:hover {
      color: var(--text);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .player-controls button,
    .close-player {
      transition: none;
    }
    .play-control:hover {
      transform: none;
    }
  }
</style>
