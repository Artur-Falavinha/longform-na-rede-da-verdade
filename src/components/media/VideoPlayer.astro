---
import { Volume2, VolumeOff } from "@lucide/astro";
import type { MediaAsset } from "../../data/types";
interface Props {
  asset: MediaAsset;
  opening?: boolean;
  cover?: boolean;
}
const { asset, opening = false, cover = false } = Astro.props;
const ambient = asset.purpose === "ambient";
---

<figure
  class:list={["video-player", { ambient, opening, cover: opening || cover }]}
  data-video-player
  data-ambient={ambient || undefined}
>
  <div class="video-shell">
    <video
      data-media-id={asset.id}
      data-purpose={asset.purpose}
      data-media-src={asset.src}
      data-mobile-src={asset.mobileSrc}
      data-mobile-poster={asset.mobilePoster}
      poster={asset.poster}
      src={asset.src}
      controls={!ambient}
      preload="none"
      muted={ambient}
      loop={ambient}
      playsinline
      width="1280"
      height="720"
      aria-label={`${asset.title} — arquivo de teste`}
    >
      <p>
        Seu navegador não reproduz este vídeo.{" "}
        <a href={asset.src}>Abrir arquivo de teste</a>.
      </p>
    </video>
    {ambient && (
      <div class="ambient-controls" hidden>
        {asset.hasAudio && (
          <button
            type="button"
            class="button"
            data-ambient-sound
            aria-label="Ativar som"
            aria-pressed="false"
          >
            <VolumeOff class="sound-off" size={64} strokeWidth={1.5} aria-hidden="true" />
            <Volume2 class="sound-on" size={64} strokeWidth={1.5} aria-hidden="true" />
          </button>
        )}
      </div>
    )}
    <div class="media-error" role="status" hidden>
      <p>Não foi possível carregar o vídeo.</p>
      <button type="button" class="button" data-media-retry>
        Tentar novamente
      </button>
      <a href={asset.src}>Abrir arquivo diretamente</a>
    </div>
  </div>
</figure>
<style>
  .video-player {
    margin-block: 3rem;
  }
  .video-shell {
    position: relative;
    background: var(--surface);
    aspect-ratio: 16/9;
  }
  .video-shell video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ambient .video-shell {
    height: 85svh;
    aspect-ratio: auto;
  }
  .ambient video {
    object-fit: contain;
    background: var(--bg);
  }
  .cover {
    margin: 0;
    height: 100svh;
    clip-path: inset(0);
  }
  .cover .video-shell {
    position: fixed;
    inset: 0;
    height: 100svh;
    z-index: 0;
  }
  .ambient-controls {
    position: absolute;
    right: var(--gutter);
    bottom: calc(2rem + var(--compact-space));
    display: flex;
    gap: 0.75rem;
  }
  [data-ambient-sound] {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text);
  }
  [data-ambient-sound] :global(svg) {
    grid-area: 1 / 1;
    display: block;
  }
  [data-ambient-sound][aria-pressed="false"] :global(.sound-on),
  [data-ambient-sound][aria-pressed="true"] :global(.sound-off) {
    visibility: hidden;
  }
  .media-error {
    position: absolute;
    inset: auto 1rem 1rem;
    background: var(--bg);
    border: 1px solid var(--accent);
    padding: 1rem;
    font-size: 0.875rem;
  }
  .media-error a {
    margin-left: 1rem;
  }
  @media (max-width: 599px) {
    .ambient-controls {
      right: 1rem;
      bottom: calc(5.5rem + var(--compact-space));
      left: 1rem;
      justify-content: center;
    }
    .ambient-controls button {
      font-size: 0.75rem;
    }
    .ambient .video-shell {
      height: 70svh;
    }
    .cover .video-shell {
      height: 100svh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover {
      clip-path: none;
    }
    .cover .video-shell {
      position: relative;
    }
  }
</style>
