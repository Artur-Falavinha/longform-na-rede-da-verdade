---
import type { TimelineEntry } from "../../data/types";
interface Props {
  entries: TimelineEntry[];
}
const { entries } = Astro.props;
---

<nav
  class="timeline-index"
  data-timeline-index
  aria-label="Acontecimentos da linha do tempo"
  hidden
>
  <button
    type="button"
    class="index-toggle"
    data-index-toggle
    aria-expanded="false"
  >
    Acontecimentos <span aria-hidden="true">+</span>
  </button>
  <ol>
    {entries.map((entry) => (
      <li>
        <a href={`#acontecimento-${entry.id}`}>
          <span class="index-bar" aria-hidden="true"></span>
          <span class="index-label">{entry.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<div class="timeline" data-timeline>
  <div class="timeline-rail" aria-hidden="true">
    <div class="timeline-fill" data-timeline-fill></div>
  </div>
  <ol>
    {entries.map((entry) => (
      <li
        class="timeline-event"
        data-timeline-event
        id={`acontecimento-${entry.id}`}
      >
        <span
          class="timeline-marker"
          data-timeline-marker
          aria-hidden="true"
        ></span>
        <span
          class="timeline-connector"
          data-timeline-connector
          aria-hidden="true"
        >
          <span></span>
        </span>
        <div class="event-content">
          <div class="event-date" data-event-date>
            <time datetime={entry.dateISO}>
              {entry.dateLabel.replace(" · data pendente", "")}
            </time>
          </div>
          <div class="event-copy">
            <h3>{entry.title}</h3>
            {entry.category && (
              <span class="event-category">{entry.category}</span>
            )}
            {(entry.status === "placeholder"
              ? [
                  "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
                ]
              : entry.paragraphs
            ).map((text) => (
              <p>{text}</p>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ol>
</div>
<style>
  .index-toggle {
    display: none;
  }
  .timeline-index {
    position: fixed;
    inset: 50% auto auto 1rem;
    transform: translateY(-50%);
    z-index: 25;
    max-height: 70vh;
    overflow-y: auto;
    width: 11rem;
    pointer-events: none;
  }
  .timeline-index ol {
    list-style: none;
    padding: 0.5rem;
    margin: 0;
  }
  .timeline-index li {
    margin: 0;
  }
  .timeline-index a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    position: relative;
    min-height: 44px;
    padding: 0.3rem 0;
    text-decoration: none;
    font: 400 0.7rem/1.35 var(--sans);
    color: var(--muted);
    transition: color 250ms ease-in-out;
    pointer-events: auto;
    width: 32px;
  }
  .index-bar {
    height: 2px;
    width: 12px;
    flex-shrink: 0;
    background: currentColor;
    transition: width 0.3s;
  }
  .index-label {
    position: absolute;
    left: 30px;
    width: 135px;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.25s,
      transform 0.35s;
    min-width: 0;
  }
  .timeline-index:hover a,
  .timeline-index:focus-within a,
  .timeline-index a[aria-current],
  .timeline-index a:hover,
  .timeline-index a:focus-visible {
    width: 100%;
  }
  .timeline-index:hover,
  .timeline-index:focus-within {
    background: var(--bg);
  }
  .timeline-index:hover .index-label,
  .timeline-index:focus-within .index-label,
  a[aria-current] .index-label {
    opacity: 1;
    transform: none;
  }
  .timeline-index a[aria-current],
  .timeline-index a:hover,
  .timeline-index a:focus-visible {
    color: var(--accent);
  }
  .timeline-index a[aria-current] .index-bar {
    width: 20px;
  }
  @media (max-width: 1199px) {
    .index-toggle {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      min-height: 44px;
      background: transparent;
      border: 0;
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      pointer-events: auto;
    }
    .timeline-index {
      inset: auto auto calc(1rem + var(--compact-space, 0px)) 0.75rem;
      transform: none;
      width: min(17rem, calc(100vw - 1.5rem));
      max-height: 45vh;
      background: var(--bg);
      border: 1px solid var(--surface);
    }
    .timeline-index li:has(a:not([aria-current])) {
      display: none;
    }
    .timeline-index[data-expanded] li:has(a:not([aria-current])) {
      display: block;
    }
    .timeline-index a {
      min-height: 44px;
      width: 100%;
    }
    .timeline-index .index-label {
      position: static;
      width: auto;
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-index a,
    .index-label,
    .index-bar {
      transition: none;
    }
  }

  @media (min-width: 1200px) {
    .timeline {
      margin-left: 6rem;
    }
  }
  .timeline {
    overflow: clip;
    position: relative;
    --date-line: 1.5rem;
    --axis: 50%;
    --connector: 2rem;
  }
  .timeline ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline-event {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6rem minmax(0, 1fr);
    position: relative;
    margin: 0;
    padding-bottom: 4.5rem;
  }
  .timeline-event:last-child {
    padding-bottom: 0;
  }
  .event-content {
    grid-column: 1;
    min-width: 0;
  }
  .timeline-event:nth-child(even) .event-content {
    grid-column: 3;
  }
  .timeline-marker {
    position: absolute;
    left: var(--axis);
    top: calc(var(--date-line) / 2);
    transform: translate(-50%, -50%);
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--muted);
    z-index: 2;
    transition: background 180ms;
  }
  .timeline-marker::after {
    content: "";
    position: absolute;
    inset: -6px;
    border: 1px solid var(--red);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.5);
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 350ms;
  }
  .timeline-event[data-reached="true"] .timeline-marker::after {
    opacity: 0.65;
    transform: scale(1);
  }
  .timeline-connector {
    position: absolute;
    left: calc(var(--axis) - var(--connector));
    top: calc(var(--date-line) / 2 - 1px);
    height: 2px;
    width: var(--connector);
    background: var(--muted);
  }
  .timeline-connector > span {
    display: block;
    height: 100%;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: right;
  }
  .timeline-event:nth-child(even) .timeline-connector {
    left: var(--axis);
  }
  .timeline-event:nth-child(even) .timeline-connector > span {
    transform-origin: left;
  }
  .timeline-rail {
    position: absolute;
    left: var(--axis);
    width: 3px;
    top: calc(var(--date-line) / 2);
    bottom: 0;
    transform: translateX(-50%);
    background: var(--muted);
  }
  .timeline-fill {
    width: 100%;
    height: 100%;
    background: var(--red);
    transform: scaleY(1);
    transform-origin: top;
  }
  .event-date {
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: var(--date-line);
    color: var(--accent);
    text-transform: uppercase;
    padding-right: 0.5rem;
  }
  .event-content h3 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.7rem, 2.65vw, 2.65rem);
  }
  .event-content p {
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .event-category {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .timeline-event[data-reached="true"] .timeline-marker {
    background: var(--red);
  }
  @media (max-width: 899px) {
    .timeline {
      --axis: 0.5rem;
      --connector: 1.4rem;
    }
    .timeline-event {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-bottom: 3.5rem;
    }
    .event-content,
    .timeline-event:nth-child(even) .event-content {
      grid-column: 2;
    }
    .timeline-connector,
    .timeline-event:nth-child(even) .timeline-connector {
      left: var(--axis);
    }
    .timeline-connector > span {
      transform-origin: left;
    }
    .event-content p {
      font-size: 1.125rem;
    }
    .event-content h3 {
      font-size: 1.75rem;
    }
  }
</style>
