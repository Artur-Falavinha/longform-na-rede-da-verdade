---
import Longform from "../layouts/Longform.astro";
import ChapterIndex from "../components/navigation/ChapterIndex.astro";
import FelcaMetrics from "../components/editorial/FelcaMetrics.astro";
import EditorialText from "../components/editorial/EditorialText.astro";
import VideoPlayer from "../components/media/VideoPlayer.astro";
import PodcastPlayer from "../components/media/PodcastPlayer.astro";
import CommentExplorer from "../components/comments/CommentExplorer.astro";
import Timeline from "../components/timeline/Timeline.astro";
import Booklet from "../components/documents/Booklet.astro";
import { research } from "../data/research";
import { media } from "../data/media";
import { timeline } from "../data/timeline";
import { editorial } from "../data/editorial";
const [opening, closing, comparison, adultization, ...podcasts] = media;
---

<Longform>
  <ChapterIndex />
  <section
    id="abertura"
    data-chapter-start
    class="ambient-chapter"
    tabindex="-1"
    aria-label="Capa em vídeo"
  >
    <VideoPlayer asset={opening} opening />
  </section>
  <main id="reportagem">
    <section
      id="contexto"
      data-chapter-start
      class="story-section"
      tabindex="-1"
      aria-labelledby="report-title"
    >
      <header class="title-block wide" data-reveal>
        <h1 id="report-title">
          Na rede
          <br />
          da verdade:
          <span class="subtitle">
            quem informa, quem acredita e quem denuncia?
          </span>
        </h1>
        <div class="rule" aria-hidden="true"></div>
      </header>
      <div class="story-column standfirst">
        <EditorialText paragraphs={editorial.standfirst} />
      </div>
      <div id="denuncia" class="story-column story-copy" tabindex="-1">
        <EditorialText paragraphs={editorial.context} />
      </div>
      <div class="story-column">
        <FelcaMetrics />
      </div>
    </section>
    <section
      id="alcance"
      data-chapter-start
      class="story-section story-continuation story-column story-copy"
      tabindex="-1"
      aria-label="O alcance de Felca"
    >
      <EditorialText paragraphs={editorial.reach} />
    </section>
    <section
      id="comentarios"
      data-chapter-start
      class="story-section story-continuation"
      tabindex="-1"
      aria-label="O que o público disse"
    >
      <div class="story-column story-copy">
        <EditorialText paragraphs={editorial.commentsIntro} />
      </div>
      <div class="wide comment-interactive">
        <CommentExplorer />
      </div>
      <div class="story-column story-copy">
        <EditorialText paragraphs={editorial.commentsOutro} />
      </div>
    </section>
    <section
      id="comparacao"
      data-chapter-start
      class="story-section"
      tabindex="-1"
      aria-labelledby="comparacao-title"
    >
      <div class="story-column story-copy">
        <h2 id="comparacao-title" class="story-heading" data-reveal>
          Entre a influência e o jornalismo
        </h2>
        <EditorialText paragraphs={editorial.comparison} />
      </div>
      <div class="story-media">
        <VideoPlayer asset={comparison} />
      </div>
    </section>
    <section
      id="jornalismo"
      data-chapter-start
      class="story-section story-continuation"
      tabindex="-1"
      aria-label="O futuro do jornalismo"
    >
      <div class="story-column story-copy">
        <EditorialText paragraphs={editorial.journalism} />
      </div>
      <figure class="story-media reuters-figure">
        <img
          src="/images/reuters-linhas-vermelhas.png"
          alt="Mais de 50% usam redes sociais semanalmente para notícias; 33% consomem conteúdo de criadores focados em notícias; 36% confiam nas notícias; 47% evitam notícias às vezes ou frequentemente. Fonte: Digital News Report 2026, Reuters Institute."
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="small muted">
          Fonte: Digital News Report 2026, Reuters Institute.
        </figcaption>
      </figure>
      <div class="story-media podcast-conversations">
        {podcasts.map((asset) => (
          <PodcastPlayer asset={asset} />
        ))}
      </div>
    </section>
    <section
      id="cronologia"
      data-chapter-start
      class="story-section"
      tabindex="-1"
      aria-labelledby="cronologia-title"
    >
      <div class="story-column story-copy">
        <h2 id="cronologia-title" class="story-heading" data-reveal>
          A realidade dos fatos
        </h2>
        <EditorialText paragraphs={editorial.chronology} />
      </div>
      <div class="wide chronology">
        <Timeline entries={timeline} />
      </div>
    </section>
    <section
      id="sobre-caso"
      data-chapter-start
      class="story-section story-continuation story-column story-copy"
      tabindex="-1"
      aria-label="Sobre o caso"
    >
      <EditorialText paragraphs={editorial.case} />
    </section>
    <section
      id="adultizacao"
      data-chapter-start
      class="story-section story-column story-copy final-copy"
      tabindex="-1"
      aria-labelledby="adultizacao-title"
    >
      <h2 id="adultizacao-title" class="story-heading" data-reveal>
        Adultização
      </h2>
      <EditorialText paragraphs={editorial.adultization.slice(0, 2)} />
      <div class="adultization-video">
        <VideoPlayer asset={adultization} />
      </div>
      <EditorialText paragraphs={editorial.adultization.slice(2)} />
      <div class="booklet-passage">
        <aside
          id="cartilha"
          class="booklet-inset"
          aria-label="Cartilha sobre adultização"
        >
          <Booklet />
        </aside>
      </div>
    </section>
    <footer
      class="story-column credits-block"
      aria-label="Créditos da reportagem"
    >
      <div class="rule" aria-hidden="true"></div>
      <ul class="byline">
        {research.authors.map((author) => (
          <li>{author}</li>
        ))}
      </ul>
      <p class="small muted">
        Orientador: {research.advisor}
        <br />
        {research.institution}
      </p>
    </footer>
    <section
      id="encerramento"
      data-chapter-start
      class="ambient-chapter"
      tabindex="-1"
      aria-label="Vídeo de encerramento"
    >
      <VideoPlayer asset={closing} cover />
    </section>
  </main>
</Longform>
<style>
  .ambient-chapter {
    height: 100svh;
    position: relative;
  }
  .story-column {
    width: min(calc(100% - 2 * var(--gutter)), 48rem);
    margin-inline: auto;
  }
  .story-media {
    width: min(calc(100% - 2 * var(--gutter)), 62rem);
    margin-inline: auto;
  }
  .story-section {
    position: relative;
    padding-block: 1.5rem;
  }
  .story-continuation {
    padding-top: 0;
  }
  .story-copy {
    font-size: clamp(1.125rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.65;
  }
  .story-copy :global(p + p) {
    margin-top: 1.4em;
  }
  .title-block {
    text-align: center;
    padding-block: clamp(2rem, 4vw, 4rem) 2rem;
  }
  h1 {
    font-size: clamp(3.5rem, 10.2vw, 9.75rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin: 1.7rem auto 1.2rem;
  }
  .subtitle {
    display: block;
    margin-top: 1.5rem;
    letter-spacing: normal;
    font: 700 clamp(1.35rem, 2.4vw, 2.3rem)/1.4 var(--serif);
  }
  .credits-block {
    padding-block: 0 4rem;
    text-align: center;
  }
  .byline {
    list-style: none;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .standfirst {
    font: 400 clamp(1.4rem, 2.6vw, 2rem)/1.5 var(--serif);
    padding-block: 0 2rem;
  }
  .story-heading {
    font-size: clamp(2.4rem, 4.5vw, 4rem);
    line-height: 1.15;
    margin-block: 2rem 2.5rem;
  }
  .comment-interactive {
    margin-block: 3.5rem;
  }
  .podcast-conversations {
    margin-top: 3rem;
  }
  .chronology {
    margin-block: 4rem 2rem;
  }
  .final-copy {
    padding-bottom: 4rem;
  }
  .reuters-figure,
  .adultization-video {
    margin-block: 2rem;
  }
  .reuters-figure img {
    width: 100%;
    height: auto;
  }
  .reuters-figure figcaption {
    display: none;
  }
  .booklet-passage {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.75rem;
  }
  .booklet-inset {
    width: min(60%, 19rem);
    scroll-margin-top: 1rem;
  }
  @media (min-width: 900px) {
    .story-copy :global(p[data-reveal]) {
      text-align: justify;
      hyphens: auto;
    }
  }
  @media (max-width: 599px) {
    .reuters-figure figcaption {
      display: block;
      text-align: center;
    }
    .title-block {
      padding-top: 3rem;
    }
    h1 {
      font-size: clamp(3.5rem, 14.8vw, 5.5rem);
    }
    .byline {
      font-size: 0.75rem;
    }
  }
</style>
